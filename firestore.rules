rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Courses: Public can read published courses; anyone authenticated/admin can manage
    match /courses/{courseId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Reviews: Public can read reviews; anyone can write/manage
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Packages: Public can read active packages; anyone can write/manage
    match /packages/{packageId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Bookings: Public can create a booking request; anyone can read and update
    match /bookings/{bookingId} {
      allow read, write: if true;
    }
    
    // Calendar availability slots: Public can read slots; anyone can manage
    match /calendar_slots/{slotId} {
      allow read, write: if true;
    }
    
    // Media & Files: Public can read; anyone can upload and manage
    match /media_files/{fileId} {
      allow read, write: if true;
    }
    
    // Site Profile / Settings: Public can read; anyone can manage
    match /site_settings/{docId} {
      allow read, write: if true;
    }

    // Admin Audit Logs: Read and write for admin operations
    match /admin_audit_logs/{logId} {
      allow read, write: if true;
    }
  }
}
